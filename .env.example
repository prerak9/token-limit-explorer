# Dashboard login — CHANGE THESE before exposing the port
TLE_USER=admin
TLE_PASS=admin

# Server
PORT=8740
HOST=0.0.0.0

# Optional: comma-separated holder names to treat as "premium" (bigger windows)
TLE_PREMIUM=

# Model used for the tiny 1-token limit probe
PROBE_MODEL=claude-haiku-4-5-20251001

# Where tokens.json is stored (default: ./data)
# TLE_DATA_DIR=./data
